# *** What is the different between := and = ? ***
# Simple assignment :=, evaluated one time.
# Recursive assignment =, valuated everytime the variable is encountered in the code., 
# for examples,when GCC=c++, then CC = ${GCC} {FLAGS} also change its value.
# https://stackoverflow.com/questions/4879592/whats-the-difference-between-and-in-makefile

EXAMPLE_libft = $(wildcard coding_examples/src/utils/libft/*)
EXAMPLE_math = $(wildcard coding_examples/src/utils/math/*)
EXAMPLE_get_next_line = $(wildcard coding_examples/src/input/get_next_line/*)

EXAMPLE_linalg = $(wildcard coding_examples/src/utils/linalg/*)
EXAMPLE_load = $(wildcard coding_examples/src/input/load/*)
EXAMPLE_table = $(wildcard coding_examples/src/input/table/*)

EXAMPLE_convolution = $(wildcard coding_examples/src/editor/convolution/*)
EXAMPLE_paint = $(wildcard coding_examples/src/editor/paint/*)

EXAMPLE_triangle_pair = $(wildcard coding_examples/src/graphic/triangle_pair/*)
EXAMPLE_triangle_arr = $(wildcard coding_examples/src/graphic/triangle_arr/*)


#-----------------------------------------------------------------------------------------------
# *** coding examples src ***
EXAMPLE_SRC = $(wildcard coding_examples/src/*/*/*.c)
SRC_MODULE = $(patsubst src/%, lib/%.a, $(wildcard src/*/*))
EXAMPLE_BIN = $(patsubst coding_examples/src/%.c, coding_examples/bin/%.out, $(EXAMPLE_SRC))

#-----------------------------------------------------------------------------------------------
# *** create unit_test ***

#-----------------------------------------------------------------------------------------------
# *** create coding_examples ***

# https://www.gnu.org/software/make/manual/make.html#Static-Pattern
all_coding_examples: $(EXAMPLE_BIN)
	@echo God said that $^ and etc.

$(EXAMPLE_BIN): $(SRC_MODULE)
	@echo Deity only said that $^ .
	